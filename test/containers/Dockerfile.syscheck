FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        bash \
        coreutils \
        util-linux \
        procps \
        hostname \
        sed \
        gawk \
        grep \
        findutils \
        diffutils \
        file \
        ca-certificates \
        curl \
        wget \
        openssl \
        mariadb-client \
        redis-tools \
        openssh-client \
        openssh-server \
        rsync \
        netcat-openbsd \
        iputils-ping \
        python3 \
        rsyslog \
        gzip \
        tar \
    && rm -rf /var/lib/apt/lists/*

# The rsyslog rule below is deliberately the only one writing /var/log/syslog:
# Debian's stock `*.*;auth,authpriv.none -/var/log/syslog` is commented out, so
# a message logged once appears in the file once. With both rules active every
# message lands twice, and no test can tell one delivery from two.
RUN printf '%s\n' \
        '$ModLoad imuxsock' \
        '$OmitLocalLogging off' \
        '$SystemLogSocketName /dev/log' \
        '*.*  -/var/log/syslog' \
        > /etc/rsyslog.d/00-testcontainers.conf \
    && sed -i 's/^\$ModLoad imklog/#$ModLoad imklog/' /etc/rsyslog.conf \
    && sed -i 's/^module(load="imklog")/#module(load="imklog")/' /etc/rsyslog.conf \
    && sed -i 's|^\*\.\*;auth,authpriv\.none|#&|' /etc/rsyslog.conf

ENV SYSCHECK_HOME=/opt/syscheck
RUN mkdir -p /opt/syscheck /var/log && touch /var/log/syslog

CMD ["sleep", "infinity"]
