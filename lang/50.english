SCRIPT_HUMAN_NAME="PGWY Certificate Enrollment Test"
HELP="Test full PGWY certificate enrollment flow: generate CSR, submit pkcs10, sign, finalize"
DESCR[0]="PGWY enrollment %s ok"
HELP[0]="all ok"
DESCR[1]="Configuration file missing: %s"
HELP[1]="Check that the P12 officer keystore and/or CA bundle path in the config exist and are readable"
DESCR[2]="CSR generation failed for %s (exit code %s)"
HELP[2]="Check openssl is installed and the working directory (/tmp) is writable"
DESCR[3]="pkcs10 submission failed: %s (%sms)"
HELP[3]="Check PGWY is reachable, the officer P12/cert-type P12 auth works, and the API path is correct"
DESCR[4]="Certificate signing failed: %s (exit code %s)"
HELP[4]="Check PgwySign.java, its classpath/jars, and the officer P12 password"
DESCR[5]="Enrollment finalization failed: %s (%sms)"
HELP[5]="Check the signature was accepted by PGWY and the CA is issuing correctly"
DESCR[6]="Enrollment OK: %s (%sms)"
HELP[6]="No action needed, enrollment flow completed successfully"
DESCR[7]="PGWY enrollment Summary ERROR msg: %s errors: %s warnings: %s"
HELP[7]="search for $SCRIPTID in logs for more detailed info or run syscheck manually"
DESCR[8]="PGWY enrollment Summary WARNING msg: %s errors: %s warnings: %s"
HELP[8]="search for $SCRIPTID in logs for more detailed info or run syscheck manually"
DESCR[9]="PGWY enrollment Summary OK"
HELP[9]="this pgwy enrollment summary is ok"
DESCR[10]="Cleanup of temp workdir failed: %s"
HELP[10]="Check /tmp permissions and manually remove stale pgwy-enroll.XXXXXX directories"

