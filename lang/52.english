SCRIPT_HUMAN_NAME="SCEP Certificate Enrollment Test"
HELP="Test SCEP enrollment (GetCACaps, GetCACert, PKCSReq, CertRep) against a SCEP server using lib/scep_client.py"
DESCR[0]="SCEP enrollment %s ok"
HELP[0]="all ok"
DESCR[1]="python3 or scep client not found: %s %s"
HELP[1]="Check PYTHON_BIN and SCEP_CLIENT in config/52.conf, scep_client.py should be in lib/"
DESCR[2]="SCEP %s: cannot talk to %s: %s"
HELP[2]="Check that the SCEP server is running, the SCEP URL/path is correct, firewall, and TLS trust (--tls-cafile) for https URLs. Also covers local openssl errors."
DESCR[3]="SCEP %s rejected by server (failInfo %s): %s"
HELP[3]="The SCEP server answered FAILURE. badRequest usually means wrong challenge password or a subject/key not allowed by the CA policy - check the SCEP server and CA logs (Nexus: PGWY log and CM event log)"
DESCR[4]="SCEP %s still pending: %s"
HELP[4]="Request is waiting for manual approval in the CA (Nexus: approve it in AWB) or raise --max-polls in SCEP_EXTRA_OPTS"
DESCR[5]="SCEP %s invalid response: %s"
HELP[5]="The response could not be parsed or failed signature, transactionID or nonce checks. Run scep_client.py manually with -v and check the SCEP server log"
DESCR[6]="SCEP enrollment OK: %s subject: %s serial: %s (%sms)"
HELP[6]="No action needed, enrollment flow completed successfully"
DESCR[7]="SCEP negative test OK: %s was rejected as expected (failInfo %s) (%sms)"
HELP[7]="No action needed, the server rejected an invalid request"
DESCR[8]="SCEP negative test FAILED: %s was not rejected (status %s) subject: %s"
HELP[8]="An invalid request (e.g. wrong challenge password) was accepted - check challenge password validation in the SCEP server / CA configuration (Nexus: PGWY SCEP handler and CM procedure)"
DESCR[9]="SCEP %s issued but with remarks:%s"
HELP[9]="Enrollment works but the response signer could not be verified against the GetCACert chain, or the server encrypts responses with a legacy cipher - review the SCEP RA/encryption settings"
DESCR[10]="SCEP enrollment Summary ERROR msg: %s errors: %s warnings: %s"
HELP[10]="search for $SCRIPTID in logs for more detailed info or run syscheck manually"
DESCR[11]="SCEP enrollment Summary WARNING msg: %s errors: %s warnings: %s"
HELP[11]="search for $SCRIPTID in logs for more detailed info or run syscheck manually"
DESCR[12]="SCEP enrollment Summary OK"
HELP[12]="this scep enrollment summary is ok"
