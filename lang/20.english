SCRIPT_HUMAN_NAME="EJBCA Error log checker"

HELP="checks fo new errors in the server log for ejbca"

DESCR[1]="No new errors in ejbca server log"
HELP[1]="No action is needed"
DESCR[2]="New error in log: %s"
HELP[2]="There was new ERRORS in the LOG file, please attend to them"
DESCR[3]="Cant find the specified ejbca log %s"
HELP[3]="maybe you havnt configured the script yet?"
DESCR[4]="New detailed error in log: %s"
HELP[4]="There was new ERRORS in the LOG file, please attend to them"
DESCR[5]="Log checker tool failed (exit %s): %s"
HELP[5]="lib/tail_errors_from_ejbca_log.py could not run, so the ejbca log was NOT checked. Try it by hand: lib/tail_errors_from_ejbca_log.py --logfile <log> --positionfile <posfile>"
