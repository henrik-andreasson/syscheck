HELP="Check the health of a Luna PCIe HSM 7"
SCRIPT_HUMAN_NAME="Luna PCIe HSM 7 health check"

DESCR[1]="CO role is activated: %s"
HELP[1]="No action is needed"
DESCR[2]="CO role activation check failed: %s"
HELP[2]="Verify the application partition slot and run 'role show -name co' manually; activate the PED-initialized CO role if needed"
DESCR[3]="Partition status is healthy: %s"
HELP[3]="No action is needed"
DESCR[4]="Partition status is not healthy: %s"
HELP[4]="Verify the application partition slot and investigate any tampered, transport mode, zeroized, or decommissioned state"
DESCR[5]="%s is operational: %s"
HELP[5]="No action is needed"
DESCR[6]="%s is not operational: %s"
HELP[6]="Run 'hsm envshow' on the HSM administrative slot and inspect the card cooling and host airflow"
DESCR[7]="Battery voltage is healthy: %s"
HELP[7]="No action is needed"
DESCR[8]="Battery voltage is approaching the warning threshold: %s"
HELP[8]="Plan battery replacement and monitor the voltage trend"
DESCR[9]="Battery voltage check failed: %s"
HELP[9]="Run 'hsm envshow' manually and replace the battery if voltage is at or below the HSM-provided threshold"
DESCR[10]="System temperature is healthy: %s"
HELP[10]="No action is needed"
DESCR[11]="System temperature is approaching the warning threshold: %s"
HELP[11]="Inspect host airflow, cooling, and ambient temperature"
DESCR[12]="System temperature check failed: %s"
HELP[12]="Run 'hsm envshow' manually and correct the cooling problem if temperature is at or above the HSM-provided threshold"
DESCR[13]="Partition storage is healthy: %s"
HELP[13]="No action is needed"
DESCR[14]="Partition storage is below the warning level: %s"
HELP[14]="Review partition objects and remove or archive objects before free storage reaches the error threshold"
DESCR[15]="Partition storage check failed: %s"
HELP[15]="Run 'partition showinfo' manually and remove or archive objects if free storage is below the configured error threshold"
DESCR[16]="Luna PCIe HSM 7 health checks completed without errors%s"
HELP[16]="Review any individual warning services; no error-level action is required"
DESCR[17]="Luna PCIe HSM 7 health check failed: %s"
HELP[17]="Review the individual error services and run the corresponding LunaCM commands manually"
