SCRIPT_HUMAN_NAME="ACME Certificate Enrollment Test"
HELP="Test full http-01 ACME enrollment flow against an ACME server via certbot"
DESCR[0]="ACME enrollment %s ok"
HELP[0]="all ok"
DESCR[1]="certbot binary not found or not executable: %s"
HELP[1]="Check certbot is installed and CERTBOT_BIN in config/51.conf points to the right path"
DESCR[2]="certbot enrollment failed for %s (exit code %s): %s"
HELP[2]="Check the ACME directory URL is reachable, EAB kid/hmac-key are valid, and the http-01 challenge can be validated (the ACME server must resolve the domain and reach port 80/the configured http-01 port on this host)"
DESCR[3]="Certificate file missing after certbot reported success: %s (%s)"
HELP[3]="certbot exited 0 but /etc/letsencrypt/live/<domain>/cert.pem was not found - investigate certbot logs manually"
DESCR[4]="ACME enrollment OK: %s (%sms)"
HELP[4]="No action needed, enrollment flow completed successfully"
DESCR[5]="Certificate for %s older than expected (%ss) - renewal may not have actually run"
HELP[5]="certbot exited 0 but the cert file mtime is stale; check for --force-renewal being silently skipped or clock skew"
DESCR[6]="ACME enrollment Summary ERROR msg: %s errors: %s warnings: %s"
HELP[6]="search for $SCRIPTID in logs for more detailed info or run syscheck manually"
DESCR[7]="ACME enrollment Summary WARNING msg: %s errors: %s warnings: %s"
HELP[7]="search for $SCRIPTID in logs for more detailed info or run syscheck manually"
DESCR[8]="ACME enrollment Summary OK"
HELP[8]="this acme enrollment summary is ok"

