SCRIPT_HUMAN_NAME="NTP in sync"

HELP="Check that chrony or systemd-timesyncd is running and synchronized"

DESCR[1]="time is synchronized: status: %s, server: %s, offset: %s, reachable sources: %s"
HELP[1]="all ok"

DESCR[2]="time synchronization warning: status: %s, server: %s, offset: %s, reachable sources: %s"
HELP[2]="check the time client and kernel synchronization state"

DESCR[3]="time is not synchronized: status: %s, server: %s, offset: %s, reachable sources: %s"
HELP[3]="check the time client configuration and network connectivity"

DESCR[4]="multiple time clients are active: status: %s, server: %s, offset: %s, reachable sources: %s"
HELP[4]="stop either chrony or systemd-timesyncd"

DESCR[5]="no supported time client is active: status: %s, server: %s, offset: %s, reachable sources: %s"
HELP[5]="start chrony or systemd-timesyncd"
